rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Étape 1 (sprint en cours) : accès réservé aux utilisateurs authentifiés.
    // TODO (backlog post-deadline) : règles fines par rôle (un étudiant ne
    // modifie que ses propres commandes, un commerçant ne modifie que ses
    // propres menus, etc.).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}