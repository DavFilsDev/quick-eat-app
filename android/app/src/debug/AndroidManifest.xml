<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Autorise le HTTP simple UNIQUEMENT en debug, pour parler aux
         émulateurs Firebase locaux (Firestore/Auth) qui ne sont pas en
         HTTPS. Ce fichier ne s'applique jamais aux builds release. -->
    <application android:usesCleartextTraffic="true" />
</manifest>